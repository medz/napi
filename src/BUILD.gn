import("//runtime/runtime_args.gni")

# Reuse the SDK's generated ICU object without changing its private targets.
source_set("icu_data") {
  deps = [ "//runtime/bin:icudtl_linkable" ]
  generated_dir = get_label_info(deps[0], "target_gen_dir")
  if (is_win) {
    sources = [ "$generated_dir/icudtl_linkable.obj" ]
  } else {
    sources = [ "$generated_dir/icudtl_linkable.S" ]
  }
}

shared_library("napi_template") {
  configs += [
    "//runtime:dart_config",
    "//runtime:dart_arch_config",
    "//runtime:dart_os_config",
    "//runtime:dart_product_config",
    "//runtime:dart_aotruntime_config",
  ]
  defines = [
    "DART_EMBED_ICU_DATA",
    "NAPI_VERSION=8",
  ]
  include_dirs = [
    ".",
    "node",
    "//runtime",
    "//third_party",
  ]
  sources = [
    "addon.cc",
    "runtime.cc",
    "//runtime/bin/icu.cc",
    "//runtime/bin/loader.cc",
    "//runtime/bin/snapshot_utils.cc",
  ]
  deps = [
    ":icu_data",
    "//runtime:libdart_aotruntime_product",
    "//runtime/bin:common_embedder_dart_io_product",
    "//runtime/bin:native_assets_api_product",
    "//runtime/bin:shared_object_loaders_product",
    "//runtime/platform:libdart_platform_aotruntime_product",
    "//third_party/icu:icuuc",
  ]

  if (is_win) {
    lib_dirs = [ "node" ]
    libs = [
      "node.lib",
      "ole32.lib",
      "iphlpapi.lib",
      "psapi.lib",
      "ws2_32.lib",
      "Rpcrt4.lib",
      "shlwapi.lib",
      "winmm.lib",
    ]
  } else if (is_mac) {
    ldflags = [
      "-Wl,-undefined,dynamic_lookup",
      "-Wl,-exported_symbol,_napi_register_module_v1",
      "-Wl,-exported_symbol,_node_api_module_get_api_version_v1",
    ]
  } else {
    inputs = [ "exports.map" ]
    ldflags = [
      "-Wl,--version-script=" + rebase_path("exports.map", root_build_dir),
      "-Wl,-Bsymbolic",
    ]
  }
}
