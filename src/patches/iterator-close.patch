diff --git a/sdk/lib/internal/internal.dart b/sdk/lib/internal/internal.dart
--- a/sdk/lib/internal/internal.dart
+++ b/sdk/lib/internal/internal.dart
@@ -32,6 +32,44 @@
 part 'print.dart';
 part 'sort.dart';
 part 'symbol.dart';
+
+abstract interface class NapiCloseableIterator {
+  void close();
+}
+
+void napiCloseIterator(Iterator? iterator, [bool suppressError = false]) {
+  try {
+    switch (iterator) {
+      case final NapiCloseableIterator closeable:
+        closeable.close();
+      case MappedIterator(_iterator: final source):
+      case WhereIterator(_iterator: final source):
+      case TakeIterator(_iterator: final source):
+      case TakeWhileIterator(_iterator: final source):
+      case SkipIterator(_iterator: final source):
+      case SkipWhileIterator(_iterator: final source):
+        napiCloseIterator(source);
+      case CastIterator(_source: final Iterator source):
+      case WhereTypeIterator(_source: final Iterator source):
+      case NonNullsIterator(_source: final Iterator source):
+      case IndexedIterator(_source: final Iterator source):
+        napiCloseIterator(source);
+      case FollowedByIterator(_currentIterator: final source):
+        napiCloseIterator(source);
+      case ExpandIterator(
+        _iterator: final source,
+        _currentExpansion: final nested,
+      ):
+        try {
+          napiCloseIterator(nested);
+        } finally {
+          napiCloseIterator(source);
+        }
+    }
+  } catch (_) {
+    if (!suppressError) rethrow;
+  }
+}
 
