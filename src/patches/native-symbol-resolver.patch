     DWORD error = GetLastError();
     OS::PrintErr("Failed to init NativeSymbolResolver (SymInitialize %" Pu32
                  ")\n",
                  error);
+    CloseHandle(process_handle);
     return;
   }
+  process_handle_ = process_handle;
 #endif
+  running_ = true;
 }
 
