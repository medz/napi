 void NativeSymbolResolver::Init() {
-  ASSERT(running_ == false);
   if (lock_ == nullptr) {
     lock_ = new Mutex();
   }
-  running_ = true;
+  MutexLocker lock(lock_);
+  ASSERT(running_ == false);
 
 // Symbol resolution API's used in this file are not supported
